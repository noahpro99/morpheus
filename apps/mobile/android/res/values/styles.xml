<resources>
    <!-- Replaces dx's light AppCompat theme: the window behind the web view
         (seen while it starts) is the app's darkest surface, not white. -->
    <style name="AppTheme" parent="@style/Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@drawable/ic_launcher_background</item>
        <item name="android:statusBarColor">#0D0F14</item>
        <item name="android:navigationBarColor">#0D0F14</item>
    </style>
</resources>
