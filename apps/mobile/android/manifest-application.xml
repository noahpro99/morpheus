        <!-- morpheus:begin -->
        <!-- Morpheus push notifications (apps/mobile/android/kotlin). Inserted by
             `just _android-extras`: dx 0.7 ignores [android.raw] application. -->
        <service android:name="dev.morpheus.mobile.MorpheusPushService" android:exported="false">
            <intent-filter>
                <action android:name="org.unifiedpush.android.connector.PUSH_EVENT" />
            </intent-filter>
        </service>
        <activity android:name="dev.morpheus.mobile.OpenRoomActivity" android:exported="false" android:theme="@android:style/Theme.NoDisplay" android:excludeFromRecents="true" android:taskAffinity="" />
        <!-- Matrix links opened elsewhere: matrix: links, and matrix.to (not
             verified, the domain is not ours: Morpheus is offered for them). -->
        <!-- Calls as the phone's (CallRinger): Telecom's self-managed calls,
             the call notification's buttons, the full-screen incoming call. -->
        <service android:name="dev.morpheus.mobile.CallConnectionService" android:exported="true" android:permission="android.permission.BIND_TELECOM_CONNECTION_SERVICE">
            <intent-filter>
                <action android:name="android.telecom.ConnectionService" />
            </intent-filter>
        </service>
        <receiver android:name="dev.morpheus.mobile.CallActionReceiver" android:exported="false" />
        <activity android:name="dev.morpheus.mobile.IncomingCallActivity" android:exported="false" android:excludeFromRecents="true" android:taskAffinity="" android:launchMode="singleInstance" android:showWhenLocked="true" android:turnScreenOn="true" />
        <!-- Morpheus in the share sheet: text, links, pictures and files. -->
        <activity android:name="dev.morpheus.mobile.ShareActivity" android:exported="true" android:theme="@android:style/Theme.NoDisplay" android:excludeFromRecents="true" android:taskAffinity="">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>
        <activity android:name="dev.morpheus.mobile.OpenLinkActivity" android:exported="true" android:theme="@android:style/Theme.NoDisplay" android:excludeFromRecents="true" android:taskAffinity="">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="matrix" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="matrix.to" />
            </intent-filter>
        </activity>
        <service android:name="dev.morpheus.mobile.CallService" android:exported="false" android:foregroundServiceType="microphone" />
        <activity android:name="dev.morpheus.mobile.PickFileActivity" android:exported="false" android:theme="@android:style/Theme.Translucent.NoTitleBar" android:excludeFromRecents="true" />
        <provider android:name="dev.morpheus.mobile.PushStartup" android:authorities="dev.morpheus.mobile.pushstartup" android:exported="false" />
        <!-- morpheus:end -->
